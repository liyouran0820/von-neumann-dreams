; Native P00 scaffold. Runtime probe rejects unsupported rendering backends.
config_version=5

[application]
config/name="Night White Mapping"
run/max_fps=60
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver="metal"
rendering_device/driver.macos="metal"
rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_opengl3=false
rendering_device/fallback_to_d3d12=false
anti_aliasing/quality/msaa_3d=2
scaling_3d/scale=1.0

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

observe_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

push_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194319)]
}

push_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}

push_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194320)]
}

push_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194322)]
}

mapping_activate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

mapping_release={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

portal_use={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}

undo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":90)]
}

hint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
